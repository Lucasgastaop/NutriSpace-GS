{
	"info": {
		"_postman_id": "nutrispace-api-collection",
		"name": "NutriSpace API",
		"description": "Collection para testar a API NutriSpace (FIAP GS).\n\n**Configuração:**\n1. Suba a API com perfil `dev` (porta 8080)\n2. Execute **Auth → Login** (credenciais abaixo)\n3. O token JWT é salvo automaticamente na variável `token`\n4. Execute as demais requisições na ordem sugerida das pastas\n\n**Usuário seed (perfil dev):**\n- E-mail: `admin@nutrispace.com`\n- Senha: `123456`",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "idPlanta",
			"value": "1"
		},
		{
			"key": "idAstronauta",
			"value": "1"
		},
		{
			"key": "idEstufa",
			"value": "1"
		},
		{
			"key": "idReservatorio",
			"value": "1"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const json = pm.response.json();",
									"    pm.collectionVariables.set('token', json.token);",
									"    pm.collectionVariables.set('idAstronauta', json.idAstronauta);",
									"    pm.test('Token JWT recebido', () => pm.expect(json.token).to.be.a('string'));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@nutrispace.com\",\n  \"senha\": \"123456\"\n}"
						},
						"url": "{{baseUrl}}/auth/login"
					}
				}
			]
		},
		{
			"name": "Raiz HATEOAS",
			"item": [
				{
					"name": "GET / (links)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"url": "{{baseUrl}}/"
					}
				}
			]
		},
		{
			"name": "Plantas",
			"item": [
				{
					"name": "Listar plantas",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/plantas"
					}
				},
				{
					"name": "Criar planta",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const body = pm.response.json();",
									"    const id = body.idPlanta || (body._embedded ? null : body.idPlanta);",
									"    if (body.idPlanta) pm.collectionVariables.set('idPlanta', body.idPlanta);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nomePlanta\": \"Alface Espacial\",\n  \"tempMinIdeal\": 18.0,\n  \"tempMaxIdeal\": 26.0,\n  \"umiMinIdeal\": 55.0\n}"
						},
						"url": "{{baseUrl}}/plantas"
					}
				},
				{
					"name": "Buscar planta por ID",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/plantas/{{idPlanta}}"
					}
				},
				{
					"name": "Atualizar planta",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nomePlanta\": \"Alface Espacial v2\",\n  \"tempMinIdeal\": 18.0,\n  \"tempMaxIdeal\": 27.0,\n  \"umiMinIdeal\": 60.0\n}"
						},
						"url": "{{baseUrl}}/plantas/{{idPlanta}}"
					}
				},
				{
					"name": "Excluir planta",
					"request": {
						"method": "DELETE",
						"url": "{{baseUrl}}/plantas/{{idPlanta}}"
					}
				}
			]
		},
